{
  "name": "antro",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "node server/index.mjs",
    "flutter:setup": "node scripts/flutter.mjs create . --project-name nexus_widget --platforms web && node scripts/flutter.mjs pub get",
    "flutter:run": "node scripts/flutter.mjs run",
    "flutter:build:dashboard": "node scripts/flutter.mjs build web --target lib/main_dashboard.dart --base-href /flutter-dashboard/ && node scripts/copy-flutter-dashboard.mjs",
    "flutter:run:dashboard": "node scripts/flutter.mjs run -d chrome --target lib/main_dashboard.dart",
    "es:up": "docker compose up -d",
    "es:down": "docker compose down",
    "es:seed": "node server/seed.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.16",
    "@angular/cli": "^20.3.16",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}